#!/usr/bin/env python3
"""Omarchy Themes for GNOME — point-and-click theme picker. All the work is done by omarchy-theme; this only calls it."""

import importlib.machinery
import importlib.util
import sys
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

try:  # glycin: GNOME's image loader, reads the webp wallpapers GTK can't
    gi.require_version("Gly", "2")
    gi.require_version("GlyGtk4", "2")
    from gi.repository import Gly, GlyGtk4  # noqa: E402
except (ValueError, ImportError):
    Gly = None

APP_ID = "io.github.rnakshay.OmarchyThemes"
CLI = Path(__file__).resolve().parent / "omarchy-theme"

# Reuse the CLI's theme discovery and colour resolver rather than duplicating them.
_loader = importlib.machinery.SourceFileLoader("omarchy_theme", str(CLI))
_spec = importlib.util.spec_from_loader("omarchy_theme", _loader)
ot = importlib.util.module_from_spec(_spec)
_loader.exec_module(ot)

THUMBS = ot.DATA / "thumbnails"
MENU_OPTIONS = {
    "apps": "GNOME App Colours",
    "folders": "Coloured Folders",
    "ptyxis": "Terminal (Ptyxis)",
    "gnome-terminal": "GNOME Terminal",
    "vscode": "VS Code, VSCodium, Cursor",
    "claude": "Claude Code",
    "btop": "btop",
    "chrome": "Chrome (asks for password)",
}
THUMB_W, THUMB_H = 320, 180
SWATCHES = ["background", "foreground", "accent", "red", "green", "yellow", "blue", "magenta"]

CSS = """
.theme-card { padding: 6px; border-radius: 14px; }
.theme-card picture { border-radius: 10px; }
/* An inset hairline, so a swatch matching the window background (recoloured apps) stays visible. */
.swatch { min-width: 18px; min-height: 10px; border-radius: 3px;
          box-shadow: inset 0 0 0 1px alpha(currentColor, 0.18); }
.preview-stage { background: black; }
"""


def thumbnail(name, theme_dir):
    """Previews are 2560×1440; scale each once and keep it, so the window opens fast."""
    src = theme_dir / "preview.png"
    if not src.is_file():
        bgs = sorted((theme_dir / "backgrounds").glob("*.*"))
        src = bgs[0] if bgs else None
    if src is None:
        return None
    dest = THUMBS / f"{name}.png"
    if not dest.is_file() or dest.stat().st_mtime < src.stat().st_mtime:
        THUMBS.mkdir(parents=True, exist_ok=True)
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(src), THUMB_W * 2, THUMB_H * 2, True)
        except GLib.Error:
            return None
        pixbuf.savev(str(dest), "png", [], [])
    return dest


def wallpapers(theme_dir):
    """Same files, same order as the CLI's --wallpaper index."""
    return sorted(p for p in (theme_dir / "backgrounds").glob("*")
                  if p.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp"))


def load_texture(path):
    """Full-size texture, off the main thread. None if nothing can read the file."""
    if Gly is not None:
        try:
            frame = Gly.Loader.new(Gio.File.new_for_path(str(path))).load().next_frame()
            return GlyGtk4.frame_get_texture(frame)
        except GLib.Error:
            pass
    try:
        return Gdk.Texture.new_from_filename(str(path))
    except GLib.Error:
        return None


class Preview(Adw.Window):
    """Full-screen look at the themes. ←/→ move through a theme's screenshot and wallpapers,
    ↑/↓ move between themes. Apply uses the theme and wallpaper on screen."""

    def __init__(self, parent, themes, index):
        super().__init__(transient_for=parent, modal=True, title="Preview")
        self.parent_window = parent
        self.themes = themes  # [(name, theme_dir)] in the grid's order
        self.generation = 0

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.heading = Adw.WindowTitle()
        header.set_title_widget(self.heading)
        choices = Gio.Menu()
        choices.append("Theme and Wallpaper (Enter)", "preview.both")
        choices.append("Theme Only (T)", "preview.theme")
        choices.append("Wallpaper Only (W)", "preview.wallpaper")
        actions = Gio.SimpleActionGroup()
        for mode in ("both", "theme", "wallpaper"):
            action = Gio.SimpleAction.new(mode, None)
            action.connect("activate", lambda _a, _p, m=mode: self.apply(m))
            actions.add_action(action)
        self.insert_action_group("preview", actions)
        self.wallpaper_action = actions.lookup_action("wallpaper")
        apply = Adw.SplitButton(label="Apply", menu_model=choices,
                                tooltip_text="Theme and wallpaper — the arrow has the other choices")
        apply.add_css_class("suggested-action")
        apply.connect("clicked", lambda *_: self.apply("both"))
        header.pack_end(apply)
        view.add_top_bar(header)

        self.view = view
        self.dots = Adw.CarouselIndicatorDots(margin_top=6, margin_bottom=6)
        view.add_bottom_bar(self.dots)
        self.set_content(view)

        # Capture phase, so the carousel never gets to treat the arrows as its own.
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.show_theme(index)
        self.fullscreen()

    def show_theme(self, index):
        self.index = index % len(self.themes)
        self.name, theme_dir = self.themes[self.index]
        self.generation += 1  # images still loading for the previous theme are dropped
        shot = theme_dir / "preview.png"
        self.walls = wallpapers(theme_dir)
        self.pages = ([("Screenshot from Omarchy (GNOME keeps its own layout)", shot)] if shot.is_file() else []) + \
            [(f"Wallpaper {i} of {len(self.walls)}", p) for i, p in enumerate(self.walls, 1)]

        # A fresh carousel per theme: emptying the old one animates its pages out and
        # leaves its position behind, so the next theme would open mid-slide.
        self.carousel = Adw.Carousel(hexpand=True, vexpand=True, allow_scroll_wheel=True)
        self.carousel.add_css_class("preview-stage")
        self.carousel.connect("page-changed", self.on_page_changed)
        self.pictures = []
        for _ in self.pages:
            picture = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, hexpand=True, vexpand=True)
            self.carousel.append(picture)
            self.pictures.append(picture)
        self.view.set_content(self.carousel)
        self.dots.set_carousel(self.carousel)
        self.target = 0  # the page we are on or sliding to; the carousel's position lags behind
        self.sliding = False  # a key-driven slide is under way; ignore the carousel's interim reports
        self.requested = set()
        self.update_title()
        self.load_around(0)

    def load_around(self, center=None):
        """Only the shown image and its neighbours: some wallpapers are 8K, and this is an 8 GB laptop."""
        center = self.target if center is None else center
        for i in (center, center + 1, center - 1):
            if 0 <= i < len(self.pages) and i not in self.requested:
                self.requested.add(i)
                threading.Thread(target=self._load, args=(self.generation, self.pictures[i], self.pages[i][1]),
                                 daemon=True).start()

    def _load(self, generation, picture, path):
        texture = load_texture(path)
        if texture is not None and generation == self.generation:
            GLib.idle_add(picture.set_paintable, texture)

    def on_page_changed(self, carousel, index):
        if carousel is not self.carousel:
            return
        if self.sliding:
            # A carousel that is laid out after a key press reports page 0 first; only the
            # slide's own arrival counts.
            self.sliding = index != self.target
            return
        self.target = index  # a swipe or scroll-wheel move
        self.update_title()
        self.load_around()

    def update_title(self):
        current = " · current" if self.name == ot.current() else ""
        self.heading.set_title(f"{ot.title(self.name)}{current}")
        where = self.pages[self.target][0] if self.pages else "No images"
        self.wallpaper_action.set_enabled(self.shown_wallpaper() is not None)
        self.heading.set_subtitle(f"{where} — theme {self.index + 1} of {len(self.themes)}")

    def step(self, delta):
        if not self.pictures:
            return
        target = min(max(self.target + delta, 0), len(self.pictures) - 1)
        if target == self.target:
            return
        self.target = target
        self.update_title()
        self.load_around()
        mapped = self.carousel.get_mapped()
        self.sliding = mapped  # unmapped, the jump is immediate and reports nothing to wait for
        self.carousel.scroll_to(self.pictures[target], mapped)
        if mapped:
            GLib.timeout_add(1000, self._settle, self.carousel)

    def _settle(self, carousel):
        """If a slide was interrupted (a swipe mid-way), trust where the carousel actually stopped."""
        if carousel is self.carousel and self.sliding:
            self.sliding = False
            self.target = min(round(carousel.get_position()), len(self.pictures) - 1)
            self.update_title()
            self.load_around()
        return False

    def on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_space):
            self.step(1)
        elif keyval == Gdk.KEY_Left:
            self.step(-1)
        elif keyval == Gdk.KEY_Down:
            self.show_theme(self.index + 1)
        elif keyval == Gdk.KEY_Up:
            self.show_theme(self.index - 1)
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.apply("both")
        elif keyval in (Gdk.KEY_t, Gdk.KEY_T):
            self.apply("theme")
        elif keyval in (Gdk.KEY_w, Gdk.KEY_W):
            self.apply("wallpaper")
        else:
            return False
        return True

    def shown_wallpaper(self):
        """1-based index of the wallpaper on screen, or None on the screenshot page."""
        path = self.pages[self.target][1] if self.pages else None
        return self.walls.index(path) + 1 if path in self.walls else None

    def apply(self, mode):
        """mode: "both", "theme" (colours, wallpaper untouched) or "wallpaper" (the one on screen only)."""
        index = self.shown_wallpaper()
        if mode == "wallpaper" and index is None:
            return  # the Omarchy screenshot is not a wallpaper
        self.close()
        self.parent_window.apply(self.name, mode, index or 1)


class Card(Gtk.FlowBoxChild):
    def __init__(self, name, theme_dir, colors):
        super().__init__()
        self.name = name
        self.theme_dir = theme_dir
        self.add_css_class("theme-card")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        overlay = Gtk.Overlay()
        self.picture = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        self.picture.set_size_request(THUMB_W, THUMB_H)
        overlay.set_child(self.picture)
        self.check = Gtk.Image(icon_name="object-select-symbolic", pixel_size=20,
                               halign=Gtk.Align.END, valign=Gtk.Align.START, margin_top=8, margin_end=8,
                               visible=False)
        self.check.add_css_class("osd")
        self.check.add_css_class("circular")
        overlay.add_overlay(self.check)
        box.append(overlay)

        row = Gtk.Box(spacing=8)
        label = Gtk.Label(label=ot.title(name), xalign=0, hexpand=True)
        label.add_css_class("heading")
        row.append(label)
        if colors.get("mode") == "light":
            mode = Gtk.Label(label="light")
            mode.add_css_class("dim-label")
            mode.add_css_class("caption")
            row.append(mode)
        box.append(row)

        swatches = Gtk.Box(spacing=3)
        provider = Gtk.CssProvider()
        rules = []
        for i, key in enumerate(SWATCHES):
            value = colors.get(key, colors.get("blue"))
            if not ot.HEX_RE.match(value or ""):
                continue
            sw = Gtk.Box(hexpand=True)
            sw.add_css_class("swatch")
            sw.add_css_class(f"sw-{name}-{i}")
            rules.append(f".sw-{name}-{i} {{ background: {value}; }}")
            swatches.append(sw)
        provider.load_from_string("\n".join(rules))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box.append(swatches)
        self.set_child(box)
        self.set_tooltip_text(f"Preview {ot.title(name)}")

    def set_current(self, current):
        self.check.set_visible(current)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Omarchy Themes", default_width=1080, default_height=720)
        self.busy = False

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.spinner = Adw.Spinner(visible=False)
        header.pack_start(self.spinner)

        header.pack_end(self._menu())
        view.add_top_bar(header)

        self.toasts = Adw.ToastOverlay()
        self.flow = Gtk.FlowBox(homogeneous=True, min_children_per_line=2, max_children_per_line=5,
                                selection_mode=Gtk.SelectionMode.NONE, activate_on_single_click=True,
                                row_spacing=12, column_spacing=12, valign=Gtk.Align.START,
                                margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.flow.connect("child-activated", self.on_activated)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(self.flow)
        self.toasts.set_child(scroller)
        view.set_content(self.toasts)
        self.set_content(view)
        self.populate()

    def _menu(self):
        # What a theme switch touches besides GNOME's mode, accent and wallpaper. The settings live
        # with omarchy-theme, so the command line sees the same choices.
        options = Gio.Menu()
        for option, label in MENU_OPTIONS.items():
            if not ot.available(option):
                continue  # an app that isn't installed
            options.append(label, f"win.opt-{option}")
            action = Gio.SimpleAction.new_stateful(f"opt-{option}", None,
                                                   GLib.Variant.new_boolean(ot.enabled(option)))
            action.connect("change-state", self.on_option, option)
            self.add_action(action)
        actions = Gio.Menu()
        actions.append("Update Themes from Omarchy", "win.sync")
        actions.append("Restore Original Settings…", "win.reset")
        menu = Gio.Menu()
        menu.append_section("Theme Also Changes", options)
        menu.append_section(None, actions)

        sync = Gio.SimpleAction.new("sync", None)
        sync.connect("activate", lambda *_: self.run(["sync"], "Themes updated", self.populate))
        self.add_action(sync)
        reset = Gio.SimpleAction.new("reset", None)
        reset.connect("activate", self.on_reset)
        self.add_action(reset)
        return Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu, primary=True)

    def populate(self):
        self.flow.remove_all()
        self.cards = {}
        current = ot.current()
        for name, (theme_dir, _) in ot.all_themes().items():
            try:
                colors = ot.resolve(theme_dir)
            except Exception:
                continue
            card = Card(name, theme_dir, colors)
            card.set_current(name == current)
            self.flow.append(card)
            self.cards[name] = card
        threading.Thread(target=self._load_thumbnails, args=(list(self.cards.values()),), daemon=True).start()

    def _load_thumbnails(self, cards):
        for card in cards:
            path = thumbnail(card.name, card.theme_dir)
            if path:
                GLib.idle_add(card.picture.set_filename, str(path))

    def on_option(self, action, value, option):
        on = value.get_boolean()
        label = MENU_OPTIONS[option].split(" (")[0]
        if option == "apps":
            message = "GNOME apps follow the theme — reopen apps to see it" if on else "GNOME apps back to default colours"
        elif option == "folders":
            message = "Folders follow the accent colour" if on else "Folders back to blue"
        else:
            message = f"{label} {'follows' if on else 'no longer follows'} the theme from the next switch"
        self.run(["enable" if on else "disable", option], message, lambda: action.set_state(value))

    def on_activated(self, flow, card):
        themes = [(c.name, c.theme_dir) for c in self.cards.values()]
        Preview(self, themes, list(self.cards).index(card.name)).present()

    def apply(self, name, mode, wallpaper=1):
        if mode == "wallpaper":
            return self.run(["wallpaper", name, str(wallpaper)], f"Wallpaper from {ot.title(name)}")
        args = ["set", name, "--wallpaper", str(wallpaper)]
        if mode == "theme":
            args += ["--skip", "wallpaper"]

        def done():
            for n, c in self.cards.items():
                c.set_current(n == name)
        self.run(args, f"{ot.title(name)} applied" + (", wallpaper kept" if mode == "theme" else ""), done)

    def on_reset(self, *_):
        dialog = Adw.AlertDialog(heading="Restore original settings?",
                                 body="Puts GNOME, the wallpaper, Ptyxis, VS Code, btop and Chrome back "
                                      "to how they were before the first theme was applied.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reset", "Restore")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)

        def response(d, r):
            if r == "reset":
                self.run(["reset"], "Original settings restored", self.populate)
        dialog.connect("response", response)
        dialog.present(self)

    def run(self, args, success, then=None):
        """Run the CLI without blocking the window; one job at a time."""
        if self.busy:
            return
        self.busy = True
        self.spinner.set_visible(True)
        self.flow.set_sensitive(False)
        proc = Gio.Subprocess.new([sys.executable, str(CLI), *args],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)

        def finished(p, result):
            _, out, _ = p.communicate_utf8_finish(result)
            self.busy = False
            self.spinner.set_visible(False)
            self.flow.set_sensitive(True)
            failed = [line.strip() for line in (out or "").splitlines() if "failed" in line]
            if p.get_exit_status() != 0:
                message = (out or "").strip().splitlines()[-1:] or ["Something went wrong"]
                self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(message[0]), timeout=6))
                return
            if then:
                then()
            title = f"{success} — {failed[0]}" if failed else success
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(title),
                                            timeout=4 if not failed else 8))
        proc.communicate_utf8_async(None, None, finished)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
