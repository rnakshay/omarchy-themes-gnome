/* Generated by omarchy-themes-gnome for {{ title }}. Rewritten on every theme switch. */
:root {
  --accent-color: {{ gtk_accent }};
  --accent-bg-color: {{ gtk_accent }};
  --accent-fg-color: {{ gtk_accent_fg }};
  --destructive-color: {{ red }};
  --destructive-bg-color: {{ red }};
  --destructive-fg-color: {{ gtk_red_fg }};
  --error-color: {{ red }};
  --error-bg-color: {{ red }};
  --error-fg-color: {{ gtk_red_fg }};
  --success-color: {{ green }};
  --success-bg-color: {{ green }};
  --success-fg-color: {{ gtk_green_fg }};
  --warning-color: {{ yellow }};
  --warning-bg-color: {{ yellow }};
  --warning-fg-color: {{ gtk_yellow_fg }};

  --window-bg-color: {{ background }};
  --window-fg-color: {{ foreground }};
  --view-bg-color: {{ gtk_view }};
  --view-fg-color: {{ foreground }};
  --headerbar-bg-color: {{ gtk_header }};
  --headerbar-fg-color: {{ foreground }};
  --headerbar-backdrop-color: {{ background }};
  --sidebar-bg-color: {{ gtk_sidebar }};
  --sidebar-fg-color: {{ foreground }};
  --sidebar-backdrop-color: {{ gtk_sidebar }};
  --secondary-sidebar-bg-color: {{ gtk_sidebar }};
  --secondary-sidebar-fg-color: {{ foreground }};
  --secondary-sidebar-backdrop-color: {{ gtk_sidebar }};
  --dialog-bg-color: {{ gtk_raised }};
  --dialog-fg-color: {{ foreground }};
  --popover-bg-color: {{ gtk_raised }};
  --popover-fg-color: {{ foreground }};
  --overview-bg-color: {{ gtk_sidebar }};
  --overview-fg-color: {{ foreground }};
  --thumbnail-bg-color: {{ gtk_raised }};
  --thumbnail-fg-color: {{ foreground }};
}
